# 复制成 .env 再填值：cp .env.example .env（Windows: copy .env.example .env）
# .env 已被 .gitignore 忽略，本模板入库。模块导入时自动读 .env，不用 source。
# 规则：一行一个 KEY=VALUE；# 开头是注释；值两侧引号可选；**已存在的环境变量优先，不会被这里覆盖**。

# 视觉模型端点（OpenAI 兼容，只需填到 /v1，脚本自己拼 /chat/completions）
VL_BASE=http://你的端点主机:端口/v1

# 密钥：必填，代码里没有默认值。缺了会在发请求前抛「缺 VL_KEY：把密钥写进 .env」
VL_KEY=sk-在这里填你的密钥

# 模型名
VL_MODEL=qwen3.8-27b

# 发图前缩到的最大宽度（整窗喂坐标误差大，裁图 + 限宽是护栏）
VL_MAX_WIDTH=1600

# 是否开 thinking。判图不用长推理，开着会吃掉 max_tokens 导致 content 为空 → 保持 0
VL_THINKING=0
